#!/bin/sh
set -eu

expected_repo="${PI_GH_FIXTURE_REPO:-github.com/fixture/workspace}"
if [ -n "${PI_GH_FIXTURE_REPO_FILE:-}" ]; then
    expected_repo=$(/bin/cat "$PI_GH_FIXTURE_REPO_FILE")
fi
test "$GH_HOST" = github.com
test "$GH_PROMPT_DISABLED" = 1
test "$GH_NO_UPDATE_NOTIFIER" = 1
test "$GH_NO_EXTENSION_UPDATE_NOTIFIER" = 1
test -z "${GH_REPO:-}"
test -z "${GH_DEBUG:-}"

mode=initial
if [ -n "${PI_GH_FIXTURE_STATE:-}" ]; then
    mode=$(/bin/cat "$PI_GH_FIXTURE_STATE")
fi
if [ -n "${PI_GH_FIXTURE_LOG:-}" ]; then
    command=$(printf '%s' "$*" | /usr/bin/tr '\n' ' ')
    printf '%s\n' "$(pwd -P)|$command" >> "$PI_GH_FIXTURE_LOG"
fi
case "$mode" in
    held|held-error)
        : > "$PI_GH_FIXTURE_GATE.started"
        remaining=200
        while [ ! -f "$PI_GH_FIXTURE_GATE.release" ] && [ "$remaining" -gt 0 ]; do
            /bin/sleep 0.05
            remaining=$((remaining - 1))
        done
        test -f "$PI_GH_FIXTURE_GATE.release"
        if [ "$mode" = held-error ]; then
            printf '%s\n' 'dial tcp: fixture request lost its connection' >&2
            exit 1
        fi
        ;;
esac
case "$mode" in
    no-auth) printf '%s\n' 'To get started, run gh auth login' >&2; exit 4 ;;
    forbidden) printf '%s\n' 'HTTP 403: Resource not accessible' >&2; exit 1 ;;
    network) printf '%s\n' 'dial tcp: lookup api.github.com: no such host' >&2; exit 1 ;;
    timeout) exec /bin/sleep 30 ;;
    malformed) printf 'not JSON\n'; exit 0 ;;
esac

item() {
    printf '{"number":%s,"title":"%s","state":"%s","repository":{"nameWithOwner":"%s"},"labels":{"nodes":%s}%s}' \
        "$1" "$2" "$3" "$repo_slug" "$4" "${5:-}"
}

options_page() {
    if [ "$mode" = wrong-repo ]; then repo_slug=fixture/unrelated; fi
    printf '{"data":{"repository":{"nameWithOwner":"%s","options":{"pageInfo":{"hasNextPage":%s},"nodes":[%s]}}}}\n' \
        "$repo_slug" "$1" "$2"
}

filter_options() {
    test "$1" = --raw-field
    test "$2" = "owner=${repo_slug%%/*}"
    test "$3" = --raw-field
    test "$4" = "name=${repo_slug#*/}"
    shift 4
    text=
    if [ "$#" -gt 0 ]; then
        test "$#" = 2
        test "$1" = --raw-field
        case "$2" in text=*) text=${2#text=} ;; *) return 64 ;; esac
    fi
    case "$document" in
        *'options: labels(first: 100, query: $text, '*)
            case "$repo_slug:$text" in
                fixture/workspace:) options_page true '{"value":"bug"},{"value":"documentation"},{"value":"needs triage"}' ;;
                fixture/workspace:bug) options_page false '{"value":"bug"}' ;;
                'fixture/workspace:triage') options_page false '{"value":"needs triage"}' ;;
                fixture/other:) options_page false '{"value":"bug"},{"value":"other only"}' ;;
                fixture/other:bug) options_page false '{"value":"bug"}' ;;
                *) options_page false '' ;;
            esac
            ;;
        *'options: mentionableUsers(first: 50, query: $text)'*)
            case "$repo_slug:$text" in
                fixture/workspace:) options_page false '{"value":"fixture-author"},{"value":"fixture-maintainer"}' ;;
                fixture/workspace:maint*) options_page false '{"value":"fixture-maintainer"}' ;;
                fixture/other:) options_page false '{"value":"other-author"}' ;;
                *) options_page false '' ;;
            esac
            ;;
        *) return 64 ;;
    esac
}

page() {
    if [ -n "$1" ]; then
        page_info=$(printf '{"hasNextPage":true,"endCursor":"%s"}' "$1")
    else
        page_info='{"hasNextPage":false,"endCursor":null}'
    fi
    if [ "$scope" = repository ]; then
        printf '{"data":{"repository":{"items":{"pageInfo":%s,"nodes":[%s]}}}}\n' "$page_info" "$2"
    else
        printf '{"data":{"items":{"pageInfo":%s,"nodes":[%s]}}}\n' "$page_info" "$2"
    fi
}

graphql() {
    test "$1" = api
    test "$2" = graphql
    test "$3" = --hostname
    test "$4" = github.com
    test "$5" = --raw-field
    document=${6#query=}
    case "$document" in 'query('*) ;; *) return 64 ;; esac
    shift 6

    repo_slug=${expected_repo#github.com/}
    case "$document" in
        *'options: '*) filter_options "$@"; return ;;
        *'pageInfo { hasNextPage endCursor }'*) ;;
        *) return 64 ;;
    esac
    state=ALL
    case "$document" in
        *'... on PullRequest'*) kind=pr; resource=pullRequests; type=is:pr ;;
        *'... on Issue'*) kind=issue; resource=issues; type=is:issue ;;
        *) return 64 ;;
    esac
    case "$document" in
        *'items: search(query: $search, type: ISSUE, first: 50, after: $after)'*)
            scope=search
            test "$1" = --raw-field
            case "$2" in
                "search=repo:$repo_slug $type is:closed is:unmerged sort:created-desc "*) state=CLOSED ;;
                "search=repo:$repo_slug $type is:open sort:created-desc "*) state=OPEN ;;
                "search=repo:$repo_slug $type is:closed sort:created-desc "*) state=CLOSED ;;
                "search=repo:$repo_slug $type is:merged sort:created-desc "*) state=MERGED ;;
                "search=repo:$repo_slug $type sort:created-desc "*) ;;
                *) return 64 ;;
            esac
            terms=${2#*sort:created-desc }
            shift 2
            ;;
        *"items: $resource(first: 50, after: "*)
            scope=repository
            test "$1" = --raw-field
            test "$2" = "owner=${repo_slug%%/*}"
            test "$3" = --raw-field
            test "$4" = "name=${repo_slug#*/}"
            shift 4
            case "$document" in
                *'states: [OPEN]'*) state=OPEN ;;
                *'states: [MERGED]'*) state=MERGED ;;
                *'states: [CLOSED]'*) state=CLOSED ;;
            esac
            ;;
        *) return 64 ;;
    esac
    after=
    if [ "$#" -gt 0 ]; then
        test "$#" = 2
        test "$1" = --raw-field
        case "$2" in after=*) after=${2#after=} ;; *) return 64 ;; esac
        if [ "$mode" = page-error ]; then
            printf '%s\n' 'dial tcp: fixture next page could not connect' >&2
            return 1
        fi
    fi

    bug='[{"name":"bug"}]'
    docs='[{"name":"documentation"}]'
    draft=',"isDraft":true'
    ready=',"isDraft":false'
    pr=$(item 42 'Update checkout' OPEN "$bug" "$draft,\"author\":{\"login\":\"fixture-author\"}")
    pr_docs=$(item 43 'No checks yet' OPEN "$docs" "$ready")
    pr_next=$(item 44 'Fix checkout retry' OPEN '[{"name":"bug"},{"name":"needs triage"}]' "$ready,\"author\":{\"login\":\"fixture-maintainer\"}")
    pr_merged=$(item 41 'Previous change' MERGED '[]' "$ready,\"author\":{\"login\":\"fixture-maintainer\"}")
    issue=$(item 71 'Checkout socket timeout' OPEN "$bug")
    issue_docs=$(item 72 'Document worktree setup' OPEN "$docs")
    issue_next=$(item 73 'Retry slow worker' OPEN '[{"name":"bug"},{"name":"needs triage"}]')
    issue_closed=$(item 70 'Old socket timeout' CLOSED "$bug")
    if [ "$mode" = empty ]; then
        page '' ''
        return
    fi
    if [ "$mode" = wrong-repo ]; then
        repo_slug=fixture/unrelated
        page '' "$(item 90 'Unrelated issue' OPEN '[]')"
        return
    fi
    if [ "$mode" = updated ]; then
        pr=$(item 42 'Update checkout (updated)' OPEN "$bug" "$ready,\"author\":{\"login\":\"fixture-author\"}")
        issue=$(item 71 'Checkout socket timeout (updated)' OPEN "$bug")
    fi
    if [ "$repo_slug" = fixture/other ]; then
        other=$(item 52 'Bug in another checkout' OPEN "$bug" "$ready,\"author\":{\"login\":\"other-author\"}")
        case "$scope:$kind:$state:$after:${terms:-}" in
            repository:pr:OPEN::|search:pr:OPEN::'label:"bug"') page '' "$other"; return ;;
            *) return 64 ;;
        esac
    fi

    case "$scope:$kind:$state:$after" in
        repository:pr:OPEN:) if [ "$mode" = updated ]; then page '' "$pr"; else page '' "$pr,$pr_docs"; fi ;;
        repository:pr:MERGED:) page '' "$pr_merged" ;;
        repository:pr:CLOSED:) page '' '' ;;
        repository:pr:ALL:) page '' "$pr,$pr_docs,$pr_merged" ;;
        repository:issue:OPEN:) page 'issues:2==' "$issue,$issue_docs" ;;
        repository:issue:OPEN:issues:2==) page '' "$issue_next" ;;
        repository:issue:CLOSED:) page '' "$issue_closed" ;;
        repository:issue:ALL:) page '' "$issue,$issue_docs,$issue_next,$issue_closed" ;;
        search:pr:OPEN:)
            case "$terms" in
                'label:"bug"') page 'pull-requests:2==' "$pr" ;;
                '"checkout"') page '' "$pr,$pr_next" ;;
                'label:"documentation"') page '' "$pr_docs" ;;
                'author:"fixture-maintainer"') page '' "$pr_next" ;;
                'author:"fixture-author"') page '' "$pr" ;;
                'label:"bug" label:"needs triage"'|\
                'author:"fixture-maintainer" label:"bug" label:"needs triage"'|\
                '"checkout" author:"fixture-maintainer" label:"bug" label:"needs triage"'|\
                '"checkout" author:"fixture-maintainer"') page '' "$pr_next" ;;
                '"empty"') page '' '' ;;
                *) return 64 ;;
            esac
            ;;
        search:pr:OPEN:pull-requests:2==)
            test "$terms" = 'label:"bug"'
            page '' "$pr,$pr_next"
            ;;
        search:pr:ALL:)
            case "$terms" in
                'author:"fixture-author"') page '' "$pr" ;;
                'label:"bug"') page '' "$pr,$pr_next" ;;
                *) return 64 ;;
            esac
            ;;
        search:pr:CLOSED:)
            case "$terms" in
                'label:"bug"'|'"checkout" author:"fixture-maintainer" label:"bug" label:"needs triage"') page '' '' ;;
                *) return 64 ;;
            esac
            ;;
        search:issue:OPEN:)
            case "$terms" in
                'label:"bug"') page 'issue-search:2==' "$issue" ;;
                '"socket"') page '' "$issue" ;;
                '"slow worker" label:"needs triage"') page '' "$issue_next" ;;
                '"repo:fixture/unrelated" "OR" "$(printf" "wrong)"')
                    page '' ''
                    ;;
                '"empty"') page '' '' ;;
                *) return 64 ;;
            esac
            ;;
        search:issue:OPEN:issue-search:2==)
            test "$terms" = 'label:"bug"'
            page '' "$issue_next"
            ;;
        search:issue:CLOSED:) test "$terms" = 'label:"bug"'; page '' "$issue_closed" ;;
        *) return 64 ;;
    esac
}

if [ "${1:-}" = api ]; then
    graphql "$@"
    exit
fi

fields=number,title,state,isDraft,author
case "$*" in
    "issue view 71 --json number,title,state,author,labels,body --repo $expected_repo")
        if [ "$mode" = missing ]; then
            printf '%s\n' "GraphQL: Could not resolve to an Issue with the number of 71." >&2
            exit 1
        fi
        if [ "$mode" = updated ]; then
            printf '%s\n' '{"number":71,"title":"Checkout socket timeout (updated)","state":"OPEN","author":{"login":"fixture-reporter"},"labels":[{"name":"bug"}],"body":"Updated fixture issue description."}'
        else
            printf '%s\n' '{"number":71,"title":"Checkout socket timeout","state":"OPEN","author":{"login":"fixture-reporter"},"labels":[{"name":"bug"}],"body":"Fixture issue description."}'
        fi
        ;;
    "issue view 73 --json number,title,state,author,labels,body --repo $expected_repo")
        printf '%s\n' '{"number":73,"title":"Retry slow worker","state":"OPEN","author":null,"labels":[{"name":"bug"},{"name":"needs triage"}],"body":""}'
        ;;
    "pr view 42 --json $fields,headRefName,baseRefName,body,statusCheckRollup,url --repo $expected_repo")
        if [ "$mode" = missing ]; then
            printf '%s\n' "GraphQL: Could not resolve to a PullRequest with the number of 42." >&2
            exit 1
        fi
        pr_url="https://$expected_repo/pull/42"
        if [ "$mode" = wrong-repo ]; then pr_url="https://github.com/fixture/unrelated/pull/42"; fi
        if [ "$mode" = updated ]; then
            printf '{"number":42,"title":"Update checkout (updated)","state":"OPEN","isDraft":false,"author":{"login":"fixture-author"},"headRefName":"new-head","baseRefName":"main","body":"Fixture description","statusCheckRollup":[{"name":"build","status":"COMPLETED","conclusion":"SUCCESS","detailsUrl":"https://checks.example.invalid/build-new"}],"url":"%s"}\n' "$pr_url"
        else
            /bin/cat <<JSON
{
  "number": 42,
  "url": "$pr_url",
  "title": "Update checkout",
  "state": "OPEN",
  "isDraft": true,
  "author": { "login": "fixture-author" },
  "headRefName": "fixture-branch",
  "baseRefName": "main",
  "body": "Fixture description",
  "statusCheckRollup": [
    { "__typename": "CheckRun", "name": "build", "status": "COMPLETED", "conclusion": "FAILURE", "workflowName": "CI", "detailsUrl": "https://checks.example.invalid/build" },
    { "__typename": "StatusContext", "context": "deploy / preview", "state": "PENDING", "targetUrl": "https://checks.example.invalid/preview" },
    { "__typename": "CheckRun", "name": "unit", "status": "IN_PROGRESS", "conclusion": "", "detailsUrl": "" },
    { "__typename": "CheckRun", "name": "lint", "status": "COMPLETED", "conclusion": "SUCCESS", "detailsUrl": "file:///tmp/fixture" }
  ]
}
JSON
        fi
        ;;
    "pr view 43 --json $fields,headRefName,baseRefName,body,statusCheckRollup,url --repo $expected_repo")
        printf '{"number":43,"title":"No checks yet","state":"OPEN","isDraft":false,"author":null,"headRefName":"new-branch","baseRefName":"main","body":"","statusCheckRollup":null,"url":"https://%s/pull/43"}\n' "$expected_repo"
        ;;
    *) printf '%s\n' "Unexpected mock gh arguments: $*" >&2; exit 64 ;;
esac
