#!/usr/bin/python3 -I
import heapq
import json
import os
import platform
import queue
import re
import sys
import threading
import time
from dataclasses import dataclass, field
from pathlib import Path
from uuid import uuid4


VERSION = "0.166.0"
MODEL = "gpt-6-luna"
COMMAND = "printf 'fixture-approved\\n'"
FAILURE = "Fixture failure after the first text delta."
PROMPT = re.compile(r"\bfixture (stream|approval|interrupt|fail|resume)\b", re.IGNORECASE)


def send(**message):
    print(json.dumps(message), flush=True)


def notify(method, **params):
    send(method=method, params=params)


def timestamp():
    return time.time_ns() // 1_000_000


@dataclass
class Turn:
    thread_id: str
    id: str = field(default_factory=lambda: str(uuid4()))
    item_id: str = field(default_factory=lambda: str(uuid4()))
    started_ms: int = field(default_factory=timestamp)
    text: str = ""
    approval_id: str = ""

    def wire(self, status="inProgress", items=()):
        completed_ms = None if status == "inProgress" else timestamp()
        return {
            "id": self.id,
            "items": list(items),
            "itemsView": "full" if items else "notLoaded",
            "status": status,
            "error": {"message": FAILURE} if status == "failed" else None,
            "startedAt": self.started_ms // 1000,
            "completedAt": None if completed_ms is None else completed_ms // 1000,
            "durationMs": None if completed_ms is None else completed_ms - self.started_ms,
        }

    def item(self):
        return {"type": "agentMessage", "id": self.item_id,
                "text": self.text, "phase": "final_answer"}

    def notify(self, method, **params):
        notify(method, threadId=self.thread_id, turnId=self.id, **params)


class Peer:
    def __init__(self, home):
        self.home = home
        self.active_turns = {}
        self.approvals = {}
        self.loaded_threads = {}
        self.timeline = []
        self.next_task = 0
        self.inbox = queue.Queue()

    def schedule(self, delay, turn, action, *args):
        self.next_task += 1
        heapq.heappush(self.timeline, (
            time.monotonic() + delay, self.next_task, turn, action, args,
        ))

    def thread_path(self, thread_id):
        if not isinstance(thread_id, str) or not re.fullmatch(r"[0-9a-f-]{36}", thread_id):
            raise ValueError("Unknown fixture thread ID")
        return self.home / f"thread-{thread_id}.json"

    def read_thread(self, thread_id):
        try:
            return json.loads(self.thread_path(thread_id).read_text(encoding="utf-8"))
        except FileNotFoundError:
            raise ValueError("Unknown fixture thread ID") from None

    def save_thread(self, thread):
        path = self.thread_path(thread["id"])
        temporary = path.with_suffix(f".{uuid4()}.tmp")
        temporary.write_text(json.dumps(thread), encoding="utf-8")
        temporary.replace(path)

    def start_thread(self, params):
        thread_id = str(uuid4())
        now = timestamp() // 1000
        thread = {
            "id": thread_id, "sessionId": thread_id, "projectId": None,
            "preview": "", "ephemeral": False, "historyMode": "legacy",
            "modelProvider": "openai", "createdAt": now, "updatedAt": now,
            "status": {"type": "idle"}, "path": None,
            "cwd": params.get("cwd") or str(self.home.parent / "project"),
            "cliVersion": VERSION, "source": "vscode", "name": None, "turns": [],
        }
        self.save_thread(thread)
        return thread

    def thread_result(self, thread, include_turns=False):
        return {
            "thread": thread if include_turns else dict(thread, turns=[]),
            "model": MODEL, "modelProvider": "openai", "cwd": thread["cwd"],
            "approvalPolicy": "on-request", "approvalsReviewer": "user",
            "sandbox": {"type": "workspaceWrite", "writableRoots": [],
                        "networkAccess": False, "excludeTmpdirEnvVar": False,
                        "excludeSlashTmp": False},
            "reasoningEffort": "low",
        }

    def delta(self, turn, text):
        if not turn.text:
            turn.notify("item/started", item=turn.item(), startedAtMs=timestamp())
        turn.text += text
        turn.notify("item/agentMessage/delta", itemId=turn.item_id, delta=text)

    def finish(self, turn, status):
        del self.active_turns[turn.thread_id]
        if turn.approval_id:
            if self.approvals.pop(turn.approval_id, None) is not None:
                notify("serverRequest/resolved", threadId=turn.thread_id, requestId=turn.approval_id)
        items = [turn.item()] if turn.text else []
        terminal = turn.wire(status, items)
        thread = self.read_thread(turn.thread_id)
        thread["turns"].append(terminal)
        thread["updatedAt"] = terminal["completedAt"]
        self.save_thread(thread)
        if items:
            turn.notify("item/completed", item=items[0], completedAtMs=timestamp())
        notify("turn/completed", threadId=turn.thread_id, turn=terminal)
        notify("thread/status/changed", threadId=turn.thread_id, status={"type": "idle"})

    def ask(self, turn):
        turn.approval_id = f"fixture-approval-{turn.id}"
        self.approvals[turn.approval_id] = turn
        send(id=turn.approval_id, method="item/commandExecution/requestApproval", params={
            "kind": "command",
            "threadId": turn.thread_id, "turnId": turn.id,
            "itemId": f"fixture-command-{turn.id}", "command": COMMAND,
            "cwd": self.read_thread(turn.thread_id)["cwd"],
            "reason": "Simulated approval. No command will run.",
            "startedAtMs": timestamp(),
        })

    def resolve_approval(self, request_id, response):
        turn = self.approvals.pop(request_id)
        notify("serverRequest/resolved", threadId=turn.thread_id, requestId=request_id)
        decision = (response.get("result") or {}).get("decision")
        if decision == "cancel":
            self.finish(turn, "interrupted")
            return
        accepted = decision in ("accept", "acceptForSession")
        self.delta(turn, "Fixture approval accepted." if accepted else "Fixture approval declined.")
        self.schedule(0.4, turn, self.finish, "completed")

    def start_turn(self, request_id, params):
        thread_id = params["threadId"]
        if thread_id not in self.loaded_threads:
            raise ValueError("Start or resume the fixture thread before starting a turn")
        if thread_id in self.active_turns:
            raise ValueError("A fixture turn is already active")

        text = "\n".join(item["text"] for item in params.get("input", [])
                         if item.get("type") == "text")
        match = PROMPT.search(text)
        scenario = match.group(1).lower() if match else "stream"
        turn = Turn(thread_id)
        self.active_turns[thread_id] = turn
        send(id=request_id, result={"turn": turn.wire()})
        notify("thread/status/changed", threadId=thread_id,
               status={"type": "active", "activeFlags": []})
        notify("turn/started", threadId=thread_id, turn=turn.wire())
        if scenario == "approval":
            self.schedule(0.7, turn, self.ask)
        elif scenario == "interrupt":
            self.schedule(0.7, turn, self.delta, "Fixture is waiting for Stop.")
        elif scenario == "fail":
            self.schedule(0.7, turn, self.delta, "Fixture output before failure.")
            self.schedule(1.7, turn, self.finish, "failed")
        else:
            if scenario == "resume":
                marker = ("Fixture thread resumed. " if self.loaded_threads[thread_id] == "resumed"
                          else "Fixture thread continued on the same connection. ")
            else:
                marker = "Fixture stream started. "
            self.schedule(0.7, turn, self.delta, marker)
            self.schedule(1.7, turn, self.delta, "Second delta. ")
            self.schedule(2.7, turn, self.delta, "Fixture complete.")
            self.schedule(3.2, turn, self.finish, "completed")

    def handle(self, message):
        request_id = message.get("id")
        method = message.get("method")
        params = message.get("params") or {}
        if method is None:
            if request_id in self.approvals:
                self.resolve_approval(request_id, message)
            return
        if request_id is None:
            return
        if method == "turn/start":
            self.start_turn(request_id, params)
            return
        if method == "turn/interrupt":
            turn = self.active_turns.get(params["threadId"])
            if turn is None or turn.id != params["turnId"]:
                raise ValueError("Unknown active fixture turn")
            send(id=request_id, result={})
            self.finish(turn, "interrupted")
            return
        if method == "initialize":
            result = {"userAgent": f"t3-turn-fixture/{VERSION}", "codexHome": str(self.home),
                      "platformFamily": "unix",
                      "platformOs": "macos" if sys.platform == "darwin" else platform.system().lower()}
        elif method == "account/read":
            result = {"account": None, "requiresOpenaiAuth": False}
        elif method == "model/list":
            result = {"nextCursor": None, "data": [{
                "id": MODEL, "model": MODEL, "displayName": "Fixture model",
                "description": "Simulated text", "hidden": False, "isDefault": True,
                "defaultReasoningEffort": "low",
                "supportedReasoningEfforts": [{"reasoningEffort": "low", "description": "Low"}],
                "inputModalities": ["text"],
            }]}
        elif method == "config/read":
            result = {"config": {"model": MODEL, "model_reasoning_effort": "low",
                                 "mcp_servers": {}},
                      "origins": {}, "layers": None}
        elif method == "skills/list":
            result = {"data": [{"cwd": cwd, "errors": [], "skills": []}
                               for cwd in params.get("cwds", [])]}
        elif method == "mcpServerStatus/list":
            result = {"data": [], "nextCursor": None}
        elif method == "thread/start":
            thread = self.start_thread(params)
            self.loaded_threads[thread["id"]] = "started"
            send(id=request_id, result=self.thread_result(thread))
            notify("thread/started", thread=thread)
            return
        elif method == "thread/resume":
            thread = self.read_thread(params["threadId"])
            self.loaded_threads[thread["id"]] = "resumed"
            result = self.thread_result(thread, include_turns=not params.get("excludeTurns"))
        elif method == "thread/read":
            thread = self.read_thread(params["threadId"])
            result = {"thread": thread if params.get("includeTurns") else dict(thread, turns=[])}
        elif method == "thread/unsubscribe":
            thread = self.read_thread(params["threadId"])
            turn = self.active_turns.get(thread["id"])
            if turn is not None:
                self.finish(turn, "interrupted")
            self.loaded_threads.pop(thread["id"], None)
            send(id=request_id, result={"status": "unsubscribed"})
            notify("thread/closed", threadId=thread["id"])
            return
        elif method == "thread/name/set":
            thread = self.read_thread(params["threadId"])
            self.save_thread(dict(thread, name=params["name"]))
            result = {}
        elif method == "thread/inject_items":
            self.read_thread(params["threadId"])
            result = {}
        else:
            send(id=request_id, error={"code": -32601, "message": f"Unsupported fixture method: {method}"})
            return
        send(id=request_id, result=result)

    def read_input(self):
        for line in sys.stdin:
            self.inbox.put(line)
        self.inbox.put(None)

    def run(self):
        threading.Thread(target=self.read_input, daemon=True).start()
        while True:
            now = time.monotonic()
            while self.timeline and self.timeline[0][0] <= now:
                _, _, turn, action, args = heapq.heappop(self.timeline)
                if self.active_turns.get(turn.thread_id) is turn:
                    action(turn, *args)
            timeout = max(0, self.timeline[0][0] - time.monotonic()) if self.timeline else None
            try:
                line = self.inbox.get(timeout=timeout)
            except queue.Empty:
                continue
            if line is None:
                return
            try:
                message = json.loads(line)
            except json.JSONDecodeError:
                send(id=None, error={"code": -32700, "message": "Invalid JSON"})
                continue
            if not isinstance(message, dict):
                send(id=None, error={"code": -32600, "message": "Expected an RPC object"})
                continue
            try:
                self.handle(message)
            except (KeyError, ValueError) as error:
                send(id=message.get("id"), error={"code": -32602, "message": str(error)})


def main():
    if sys.argv[1:] == ["--version"]:
        print(f"codex-cli {VERSION}")
        return
    if sys.argv[1:2] != ["app-server"]:
        sys.exit("T3 Turn Fixture supports only app-server and --version")
    home_var = os.environ.get("CODEX_HOME")
    if not home_var:
        sys.exit("Set CODEX_HOME to the directory created by configure.py")
    home = Path(home_var).resolve()
    if not (home / ".t3-turn-fixture").is_file():
        sys.exit("Use a disposable CODEX_HOME created by configure.py")
    Peer(home).run()


if __name__ == "__main__":
    main()
